+      this.service.triggerToast(
+        'WARNING',
+        'Precio inválido',
+        'Ingrese un precio válido.'
+      );
+
+      return;
+    }
+
+    const request: ProductoRequest = {
+
+      nombre:
+        f.nombre.trim(),
+
+      descripcion:
+        f.descripcion.trim() ||
