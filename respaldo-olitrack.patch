+})
+export class DriverWorkspaceComponent implements OnInit {
+
+  readonly service =
+    inject(OlitrackService);
+
+
+  readonly miRepartidorComoLista =
+    computed(() => {
+
+      const perfil =
+        this.service.repartidorProfile();
+
+      return perfil
+        ? [perfil]
+        : [];
+
+    });
+
+
+  readonly pedidoFallido =
+    signal<Pedido | null>(null);
+
+
+  motivoFallido = '';
+
+
+  async ngOnInit(): Promise<void> {
+
+    await Promise.all([
+      this.service.reloadRepartidorProfile(),
+      this.service.reloadMisEntregas(),
+      this.service.reloadConfiguracion()
+    ]);
+
+  }
+
+
+  puedeAceptar(p: Pedido): boolean {
+
+    return (
+      !p.entregaAceptada &&
+      (
+        p.estado === 'CONFIRMADO' ||
+        p.estado === 'EN_PREPARACION'
+      )
+    );
+
+  }
+
+
+  async cambiarMiEstado(
+    estado: string
+  ): Promise<void> {
+
+    await this.service.cambiarMiEstadoRepartidor(
+      estado as any
+    );
+
+    await this.service.reloadRepartidorProfile();
+
+  }
+
+
+  async aceptar(
+    pedidoId: string
+  ): Promise<void> {
+
+    await this.service.aceptarEntrega(
+      pedidoId
+    );
+
+    await this.service.reloadMisEntregas();
+
+  }
+
+
+  async salirARuta(
+    pedidoId: string
+  ): Promise<void> {
+
+    await this.service.changeOrderStatus(
+      pedidoId,
+      'EN_CAMINO'
+    );
+
+    await this.service.reloadMisEntregas();
+
+  }
+
+
+  async marcarLlegada(
+    pedidoId: string
+  ): Promise<void> {
+
+    await this.service.registrarLlegada(
+      pedidoId
+    );
+
+    await this.service.reloadMisEntregas();
+
+  }
+
+
+  async cambiarEstado(
+    pedidoId: string,
+    estado: 'ENTREGADO'
+  ): Promise<void> {
+
+    await this.service.changeOrderStatus(
+      pedidoId,
+      estado
+    );
+
+    await this.service.reloadMisEntregas();
+
+  }
+
+
+  abrirEntregaFallida(
+    pedido: Pedido
+  ): void {
+
+    this.motivoFallido = '';
+
+    this.pedidoFallido.set(
+      pedido
+    );
+
+  }
+
+
+  async confirmarEntregaFallida(): Promise<void> {
+
+    const pedido =
+      this.pedidoFallido();
+
+    const motivo =
+      this.motivoFallido.trim();
+
+    if (
+      !pedido ||
+      !motivo
+    ) {
+      return;
+    }
+
+    await this.service.registrarEntregaFallida(
+      pedido.id,
+      motivo
+    );
+
+    this.pedidoFallido.set(null);
+
+    this.motivoFallido = '';
+
+    await this.service.reloadMisEntregas();
+
+  }
+
+
+  async actualizarMiPosicion(): Promise<void> {
+
+    const perfil =
+      this.service.repartidorProfile();
+
+    if (!perfil) {
+      return;
+    }
+
+
+    if (!navigator.geolocation) {
+
+      this.service.triggerToast(
+        'WARNING',
+        'GPS no disponible',
+        'Tu navegador no soporta geolocalización.'
+      );
+
+      return;
+    }
+
+
+    navigator.geolocation.getCurrentPosition(
+
+      async (pos) => {
+
+        try {
+
+          await this.service.updateDriverLocation(
+            perfil.id,
+            pos.coords.latitude,
+            pos.coords.longitude
+          );
+
+          this.service.triggerToast(
+            'INFO',
+            'GPS Actualizado',
+            'Tu posición fue enviada al centro de control.'
+          );
+
+          await this.service.reloadRepartidorProfile();
+
+        } catch (error) {
+
+          console.error(
+            'Error actualizando GPS:',
+            error
+          );
+
+          this.service.triggerToast(
+            'WARNING',
+            'Error GPS',
+            'No se pudo actualizar tu posición.'
+          );
+
+        }
+
+      },
+
+      (error) => {
+
+        console.error(
+          'Error de geolocalización:',
+          error
+        );
+
+        this.service.triggerToast(
+          'WARNING',
+          'GPS denegado',
+          'Activa el permiso de ubicación en tu navegador.'
+        );
+
+      },
+
+      {
+        enableHighAccuracy: true,
+        timeout: 10000,
+        maximumAge: 0
+      }
+
+    );
+
+  }
+
+
+  async reportarIncidencia(
+    pedidoId: string
+  ): Promise<void> {
+
+    const descripcion =
+      prompt(
+        'Describe brevemente la incidencia:'
+      );
+
+    if (!descripcion?.trim()) {
+      return;
+    }
+
+    await this.service.registrarIncidencia(
+      pedidoId,
+      'OTRO',
+      descripcion.trim()
+    );
+
+  }
+
+}
