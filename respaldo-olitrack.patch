+})
+export class ClientPortalComponent implements OnInit {
+
+  readonly service = inject(OlitrackService);
+
+  readonly activeTab =
+    signal<'CATALOGO' | 'MIS_PEDIDOS'>('CATALOGO');
+
+  readonly showCheckoutModal =
+    signal(false);
+
+  readonly showProfileModal =
+    signal(false);
+
+  readonly confirmando =
+    signal(false);
+
+  readonly metodos: MetodoPago[] = [
+    'YAPE',
+    'PLIN',
+    'EFECTIVO',
+    'TARJETA'
+  ];
+
+  readonly selectedMetodo =
+    signal<MetodoPago>('YAPE');
+
+  checkoutDireccion = '';
+  checkoutObservaciones = '';
+  errorCheckout = '';
+
+  profileNombreNegocio = '';
+  profileDireccion = '';
+  profileReferencia = '';
+
+  async ngOnInit(): Promise<void> {
+
+    /*
+     * IMPORTANTE:
+     * No usamos Promise.all() aquí.
+     *
+     * Si /clientes/me devuelve 404,
+     * NO queremos que eso rompa todo el portal.
+     */
+
+    try {
+      await this.service.reloadProductos();
+    } catch (error) {
+      console.error(
+        'Error al cargar productos:',
+        error
+      );
+    }
+
+    try {
+      await this.service.reloadClienteProfile();
+    } catch (error) {
+      console.error(
+        'No se pudo cargar el perfil del cliente:',
+        error
+      );
+    }
+
+    const perfil =
+      this.service.clienteProfile();
+
+    if (perfil) {
+      this.checkoutDireccion =
+        perfil.direccion;
+
+      this.profileNombreNegocio =
+        perfil.nombreNegocio;
+
+      this.profileDireccion =
+        perfil.direccion;
+
+      this.profileReferencia =
+        perfil.referencia ?? '';
+    }
+  }
+
+  async cambiarAMisPedidos(): Promise<void> {
+
+    this.activeTab.set('MIS_PEDIDOS');
+
+    /*
+     * Los pedidos son lo principal.
+     * Si fallan GPS, repartidores o configuración,
+     * no debemos impedir que se muestren.
+     */
+
+    try {
+      await this.service.reloadMisPedidos();
+    } catch (error) {
+      console.error(
+        'Error al cargar mis pedidos:',
+        error
+      );
+    }
+
+    try {
+      await this.service.reloadRepartidoresDisponibles();
+    } catch (error) {
+      console.error(
+        'Error al cargar repartidores:',
+        error
+      );
+    }
+
+    try {
+      await this.service.reloadConfiguracion();
+    } catch (error) {
+      console.error(
+        'Error al cargar configuración:',
+        error
+      );
+    }
+  }
+
+  openCheckout(): void {
+
+    this.errorCheckout = '';
+
+    const perfil =
+      this.service.clienteProfile();
+
+    /*
+     * Si existe perfil y tiene dirección,
+     * usamos esa dirección como valor inicial.
+     */
+    if (
+      perfil?.direccion &&
+      !this.checkoutDireccion.trim()
+    ) {
+      this.checkoutDireccion =
+        perfil.direccion;
+    }
+
+    this.showCheckoutModal.set(true);
+  }
+
+  async confirmOrder(): Promise<void> {
+
+    const perfil =
+      this.service.clienteProfile();
+
+    if (!perfil) {
+      this.errorCheckout =
+        'No se encontró el perfil del cliente.';
+
+      return;
+    }
+
+    if (!this.checkoutDireccion.trim()) {
+      this.errorCheckout =
+        'Ingresa una dirección de entrega.';
+
+      return;
+    }
+
+    if (this.service.cart().length === 0) {
+      this.errorCheckout =
+        'El carrito está vacío.';
+
+      return;
+    }
+
+    /*
+     * Evita doble clic / doble pedido.
+     */
+    if (this.confirmando()) {
+      return;
+    }
+
+    this.confirmando.set(true);
+    this.errorCheckout = '';
+
+    try {
+
+      await this.service.createOrder({
+        direccionEntrega:
+          this.checkoutDireccion.trim(),
+
+        ubicacionEntrega:
+          perfil.ubicacion,
+
+        observaciones:
+          this.checkoutObservaciones.trim() ||
+          undefined,
+
+        metodoPago:
+          this.selectedMetodo()
+      });
+
+      /*
+       * El pedido fue creado correctamente.
+       */
+
+      this.showCheckoutModal.set(false);
+
+      this.checkoutObservaciones = '';
+
+      /*
+       * Cambiamos a Mis Pedidos.
+       *
+       * Esta función ahora está protegida:
+       * aunque falle GPS/configuración,
+       * no bloqueará el flujo.
+       */
+      await this.cambiarAMisPedidos();
+
+    } catch (error: unknown) {
+
+      console.error(
+        'Error al crear pedido:',
+        error
+      );
+
+      if (
+        typeof error === 'object' &&
+        error !== null &&
+        'error' in error
+      ) {
+
+        const errorHttp =
+          (
+            error as {
+              error?: {
+                mensaje?: string;
+                message?: string;
+              } | string;
+            }
+          ).error;
+
+        if (
+          typeof errorHttp === 'object' &&
+          errorHttp !== null
+        ) {
+
+          this.errorCheckout =
+            errorHttp.mensaje ??
+            errorHttp.message ??
+            'No se pudo crear el pedido.';
+
+        } else if (
+          typeof errorHttp === 'string'
+        ) {
+
+          this.errorCheckout =
+            errorHttp;
+
+        } else {
+
+          this.errorCheckout =
+            'No se pudo crear el pedido.';
+        }
+
+      } else if (
+        error instanceof Error
+      ) {
+
+        this.errorCheckout =
+          error.message;
+
+      } else {
+
+        this.errorCheckout =
+          'No se pudo crear el pedido.';
+      }
+
+    } finally {
+
+      /*
+       * SIEMPRE libera el botón.
+       * Esto evita que quede permanentemente
+       * en "Enviando...".
+       */
+      this.confirmando.set(false);
+    }
+  }
+
+  async subirComprobante(
+    pedidoId: string,
+    event: Event
+  ): Promise<void> {
+
+    const input =
+      event.target as HTMLInputElement;
+
+    const archivo =
+      input.files?.[0];
+
+    if (!archivo) {
+      return;
+    }
+
+    try {
+
+      await this.service.subirEvidencia(
+        pedidoId,
+        archivo
+      );
+
+      /*
+       * Recargar pedidos para mostrar
+       * inmediatamente "Comprobante subido".
+       */
+      await this.service.reloadMisPedidos();
+
+    } catch (error: unknown) {
+
+      console.error(
+        'Error al subir comprobante:',
+        error
+      );
+
+      this.errorCheckout =
+        error instanceof Error
+          ? error.message
+          : 'No se pudo subir el comprobante.';
+    }
+  }
+
+  async calificar(
+    pedidoId: string,
+    estrellas: number
+  ): Promise<void> {
+
+    try {
+
+      await this.service.calificarPedido(
+        pedidoId,
+        estrellas
+      );
+
+      await this.service.reloadMisPedidos();
+
+    } catch (error: unknown) {
+
+      console.error(
+        'Error al calificar pedido:',
+        error
+      );
+    }
+  }
+
+  async cancelar(
+    pedidoId: string
+  ): Promise<void> {
+
+    if (
+      !confirm(
+        '¿Seguro que deseas cancelar este pedido?'
+      )
+    ) {
+      return;
+    }
+
+    try {
+
+      await this.service.cancelarPedido(
+        pedidoId
+      );
+
+      await this.service.reloadMisPedidos();
+
+    } catch (error: unknown) {
+
+      console.error(
+        'Error al cancelar pedido:',
+        error
+      );
+    }
+  }
+
+  async saveProfileChanges(): Promise<void> {
+
+    if (
+      !this.profileNombreNegocio.trim() ||
+      !this.profileDireccion.trim()
+    ) {
+      console.warn(
+        'El nombre del negocio y la dirección son obligatorios.'
+      );
+
+      return;
+    }
+
+    try {
+
+      await this.service.updateClienteProfile({
+        nombreNegocio:
+          this.profileNombreNegocio.trim(),
+
+        direccion:
+          this.profileDireccion.trim(),
+
+        referencia:
+          this.profileReferencia.trim() ||
+          undefined
+      });
+
+      await this.service.reloadClienteProfile();
+
+      /*
+       * Actualizar dirección del checkout
+       * después de guardar el perfil.
+       */
+      const perfil =
+        this.service.clienteProfile();
+
+      if (perfil) {
+        this.checkoutDireccion =
+          perfil.direccion;
+      }
+
+      this.showProfileModal.set(false);
+
+    } catch (error: unknown) {
+
+      console.error(
+        'Error al actualizar perfil:',
+        error
+      );
+    }
+  }
+}
