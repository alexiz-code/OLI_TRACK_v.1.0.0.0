+import {
+  Component,
+  OnInit,
+  inject
+} from '@angular/core';
+
+import { RouterLink } from '@angular/router';
+import { HttpClient } from '@angular/common/http';
+
+import { AuthService } from '../../core/services/auth.service';
+import { Producto } from '../../core/models/olitrack.models';
+import { environment } from '../../../environments/environment';
+
+@Component({
+  selector: 'app-home',
+  standalone: true,
+
+  imports: [
+    RouterLink
+  ],
+
+  template: `
+    <!-- ===================================================== -->
+    <!-- NAVBAR -->
+    <!-- ===================================================== -->
+
+    <nav class="navbar">
+
+      <div class="navbar-inner">
+
+        <span class="logo">
+          ❄️ OLITRACK
+        </span>
+
+        <div class="navbar-links">
+
+          <a routerLink="/catalogo">
+            Catálogo
+          </a>
+
+          <a routerLink="/consulta">
+            Contáctanos
+          </a>
+
+          @if (!authService.estaAutenticado()) {
+
+            <a
+              routerLink="/auth/login"
+              class="btn-outline"
+            >
+              Iniciar sesión
+            </a>
+
+          }
+
+          @if (authService.estaAutenticado()) {
+
+            <a
+              [routerLink]="rutaCuenta"
+              class="btn-primary"
+            >
+              Mi cuenta
+            </a>
+
+          }
+
+        </div>
+
+      </div>
+
+    </nav>
+
+
+    <!-- ===================================================== -->
+    <!-- HERO -->
+    <!-- ===================================================== -->
+
+    <section class="hero">
+
+      <div class="hero-texto">
+
+        <h1>
+          Hielo fresco, entregado cuando lo necesitas
+        </h1>
+
+        <p>
+          OLI FRESH ICE lleva hielo de calidad a tu negocio
+          en Ayacucho, con seguimiento GPS en tiempo real.
+        </p>
+
+        <a
+          [routerLink]="rutaPedido"
+          class="btn-cta"
+        >
+          Pide tu hielo ahora
+        </a>
+
+      </div>
+
+      <div class="hero-imagen">
+        🧊
+      </div>
+
+    </section>
+
+
+    <!-- ===================================================== -->
+    <!-- PRODUCTOS DESTACADOS -->
+    <!-- ===================================================== -->
+
+    @if (productosDestacados.length > 0) {
+
+      <section class="catalogo-destacado">
+
+        <h2>
+          Nuestros productos
+        </h2>
+
+        <div class="grid-productos">
+
+          @for (p of productosDestacados; track p.id) {
+
+            <div class="tarjeta-producto">
+
+              <div class="imagen-producto">
+
+                @if (p.imagenUrl) {
+
+                  <img
+                    [src]="p.imagenUrl"
+                    [alt]="p.nombre"
+                  />
+
+                } @else {
+
+                  <span>
+                    🧊
+                  </span>
+
+                }
+
+              </div>
+
+              <h4>
+                {{ p.nombre }}
+              </h4>
+
+              <p class="precio">
+                S/ {{ p.precioUnitario.toFixed(2) }}
+                /
+                {{ p.unidadMedida }}
+              </p>
+
+            </div>
+
+          }
+
+        </div>
+
+        <a
+          routerLink="/catalogo"
+          class="btn-outline"
+        >
+          Ver catálogo completo
+        </a>
+
+      </section>
+
+    }
+
+
+    <!-- ===================================================== -->
+    <!-- CONSULTA -->
+    <!-- ===================================================== -->
+
+    <section class="cta-consulta">
+
+      <h2>
+        ¿Tienes preguntas antes de pedir?
+      </h2>
+
+      <a
+        routerLink="/consulta"
+        class="btn-outline"
+      >
+        Enviar una consulta
+      </a>
+
+    </section>
+
+
+    <!-- ===================================================== -->
+    <!-- FOOTER -->
+    <!-- ===================================================== -->
+
+    <footer class="footer">
+
+      <p>
+        © 2026 OLI FRESH ICE. Todos los derechos reservados.
+      </p>
+
+    </footer>
+  `,
+
+  styleUrl: './home.component.css'
+})
+export class HomeComponent implements OnInit {
+
+  private readonly http = inject(HttpClient);
+
+  readonly authService = inject(AuthService);
+
+  productosDestacados: Producto[] = [];
+
+  ngOnInit(): void {
+
+    this.http
+      .get<Producto[]>(
+        `${environment.apiUrl}/productos`
+      )
+      .subscribe({
+
+        next: productos => {
+          this.productosDestacados = productos.slice(0, 6);
+        },
+
+        error: error => {
+          console.error(
+            'Error al cargar productos destacados:',
+            error
+          );
+        }
+
+      });
+  }
+
+  get rutaPedido(): string {
+
+    return this.authService.tieneRol('CLIENTE')
+      ? '/cliente'
+      : '/catalogo';
+  }
+
+  get rutaCuenta(): string {
+
+    if (
+      this.authService.tieneRol('ADMINISTRADOR')
+    ) {
+      return '/admin';
+    }
+
+    if (
+      this.authService.tieneRol('SUPERVISOR')
+    ) {
+      return '/supervisor';
+    }
+
+    if (
+      this.authService.tieneRol('REPARTIDOR')
+    ) {
+      return '/repartidor';
+    }
+
+    return '/cliente';
+  }
+}
