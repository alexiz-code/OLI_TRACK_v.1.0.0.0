+      void this.cargarDatos();
+
+      const timer =
+        setInterval(() => {
+
+          if (
+            this.tab() === 'MAPA_GPS' &&
+            !document.hidden
+          ) {
+
+            this.service
+              .reloadRepartidores()
+              .catch(() => undefined);
+
+          }
+
+        }, 15000);
+
+      this.destroyRef.onDestroy(
+        () => clearInterval(timer)
