+import { Injectable } from '@angular/core';
+import { Router } from '@angular/router';
+import { HttpClient } from '@angular/common/http';
+
+import { initializeApp } from 'firebase/app';
+
+import {
+  getAuth,
+  signInWithEmailAndPassword,
+  signOut,
+  onAuthStateChanged,
+  User as FirebaseUser
+} from 'firebase/auth';
+
+import {
+  BehaviorSubject,
+  firstValueFrom,
+  Observable,
+  timeout
+} from 'rxjs';
+
+import { environment } from '../../../environments/environment';
+
+import {
+  Usuario,
+  RegistroRequest
+} from '../models/olitrack.models';
+
+@Injectable({
+  providedIn: 'root'
+})
+export class AuthService {
+
+  // =========================================================
+  // FIREBASE
+  // =========================================================
+
+  private app = initializeApp(environment.firebase);
+
+  private auth = getAuth(this.app);
+
+  // =========================================================
+  // USUARIO ACTUAL
+  // =========================================================
+
+  private usuarioActualSubject =
+    new BehaviorSubject<Usuario | null>(null);
+
+  usuarioActual$: Observable<Usuario | null> =
+    this.usuarioActualSubject.asObservable();
+
+  // =========================================================
+  // ESTADO DE CARGA DE SESIÓN
+  // =========================================================
+
+  private cargandoSesionSubject =
+    new BehaviorSubject<boolean>(true);
+
+  cargandoSesion$ =
+    this.cargandoSesionSubject.asObservable();
+
+  // =========================================================
+  // CONSTRUCTOR
+  // =========================================================
+
+  constructor(
+    private http: HttpClient,
+    private router: Router
+  ) {
+
+    onAuthStateChanged(
+      this.auth,
+      async (firebaseUser) => {
+
+        console.log(
+          '[AuthService] Estado Firebase:',
+          firebaseUser
+            ? `Autenticado: ${firebaseUser.email}`
+            : 'No autenticado'
+        );
+
+        try {
+
+          if (firebaseUser) {
+
+            await this.cargarPerfilPropio();
+
+          } else {
+
+            this.usuarioActualSubject.next(null);
+          }
+
+        } catch (error) {
+
+          console.error(
+            '[AuthService] Error durante la restauración de sesión:',
+            error
+          );
+
+          this.usuarioActualSubject.next(null);
+
+        } finally {
+
+          this.cargandoSesionSubject.next(false);
+        }
+      }
+    );
+  }
+
+  // =========================================================
+  // LOGIN
+  // =========================================================
+
+  async login(
+    email: string,
+    password: string
+  ): Promise<void> {
+
+    console.log(
+      '[AuthService] Intentando iniciar sesión...'
+    );
+
+    console.log(
+      '[AuthService] Email:',
+      email
+    );
+
+    try {
+
+      const credential =
+        await signInWithEmailAndPassword(
+          this.auth,
+          email.trim(),
+          password
+        );
+
+      console.log(
+        '[AuthService] Firebase login correcto'
+      );
+
+      console.log(
+        '[AuthService] UID:',
+        credential.user.uid
+      );
+
+      console.log(
+        '[AuthService] Email:',
+        credential.user.email
+      );
+
+      /*
+       * Esperamos explícitamente a que el perfil de
+       * OLITRACK quede cargado.
+       *
+       * Esto evita que RegistroComponent continúe
+       * antes de que usuarioActual esté disponible.
+       */
+      await this.esperarPerfilActual();
+
+    } catch (error: any) {
+
+      console.error(
+        '========================================'
+      );
+
+      console.error(
+        '[AuthService] ERROR FIREBASE'
+      );
+
+      console.error(
+        'Código:',
+        error?.code
+      );
+
+      console.error(
+        'Mensaje:',
+        error?.message
+      );
+
+      console.error(
+        'Nombre:',
+        error?.name
+      );
+
+      console.error(
+        'Error completo:',
+        error
+      );
+
+      console.error(
+        '========================================'
+      );
+
+      throw error;
+    }
+  }
+
+
+async limpiarSesion(): Promise<void> {
+  try {
+    if (this.auth.currentUser) {
+      console.log(
+        '[AuthService] Cerrando sesión anterior antes del registro...'
+      );
+
+      await signOut(this.auth);
+    }
+
+    this.usuarioActualSubject.next(null);
+
+    console.log(
+      '[AuthService] Sesión anterior limpiada.'
+    );
+  } catch (error) {
+    console.error(
+      '[AuthService] Error limpiando sesión:',
+      error
+    );
+
+    this.usuarioActualSubject.next(null);
+
+    throw error;
+  }
+}
+
+  // =========================================================
+  // REGISTRO DE CLIENTE
+  // =========================================================
+
+  /**
+   * Crea solamente la cuenta del usuario.
+   *
+   * NO inicia sesión aquí.
+   *
+   * Flujo:
+   *
+   * POST /auth/registro
+   *
+   * Después RegistroComponent pasa al paso 2.
+   */
+  async registrarCliente( request: RegistroRequest ): 
+  Promise<Usuario> { 
+    console.log('[AuthService] Registrando nuevo cliente...'); 
+    console.log('[AuthService] URL:', `${environment.apiUrl}/auth/registro`); 
+    console.log('[AuthService] Datos enviados:', { nombre: request.nombre, email: request.email, 
+      telefono: request.telefono, rol: request.rol }); 
+      try { const usuario = await firstValueFrom( 
+        this.http.post<Usuario>( `${environment.apiUrl}/auth/registro`, request ).pipe( timeout(30000) 
+      )
+    ); console.log( '[AuthService] Cuenta registrada correctamente:', usuario ); 
+    return usuario; } catch (error: any) { console.error('========================================'); 
+      console.error('[AuthService] ERROR REGISTRANDO CLIENTE'); console.error('========================================'); 
+      console.error( '[AuthService] URL:', `${environment.apiUrl}/auth/registro` ); console.error( '[AuthService] Error:', error ); 
+      console.error( '[AuthService] Nombre:', error?.name ); console.error( '[AuthService] Mensaje:', error?.message ); 
+      console.error( '[AuthService] Código HTTP:', error?.status ); console.error( '[AuthService] Error completo:', error ); 
+      console.error('========================================'); throw error; } 
+    }
+
+  // =========================================================
+  // LOGOUT
+  // =========================================================
+
+  async logout(): Promise<void> {
+
+    try {
+
+      await signOut(this.auth);
+
+      this.usuarioActualSubject.next(null);
+
+      await this.router.navigateByUrl('/');
+
+    } catch (error) {
+
+      console.error(
+        '[AuthService] Error cerrando sesión:',
+        error
+      );
+
+      throw error;
+    }
+  }
+
+  // =========================================================
+  // CARGAR PERFIL
+  // =========================================================
+
+  private async cargarPerfilPropio(): Promise<void> {
+
+    try {
+
+      console.log(
+        '[AuthService] Obteniendo perfil propio...'
+      );
+
+      const usuario = await firstValueFrom(
+        this.http.get<Usuario>(
+          `${environment.apiUrl}/usuarios/me`
+        ).pipe(
+          timeout(8000)
+        )
+      );
+
+      console.log(
+        '[AuthService] Perfil obtenido:',
+        usuario
+      );
+
+      this.usuarioActualSubject.next(usuario);
+
+    } catch (error) {
+
+      console.error(
+        '[AuthService] Error obteniendo /usuarios/me:',
+        error
+      );
+
+      this.usuarioActualSubject.next(null);
+
+      throw error;
+    }
+  }
+
+  // =========================================================
+  // ESPERAR PERFIL ACTUAL
+  // =========================================================
+
+  private async esperarPerfilActual(): Promise<void> {
+
+    /*
+     * Si ya fue cargado correctamente, no necesitamos
+     * esperar nuevamente.
+     */
+    if (this.usuarioActualSubject.value) {
+      return;
+    }
+
+    /*
+     * onAuthStateChanged() puede tardar unos milisegundos
+     * en ejecutar cargarPerfilPropio().
+     *
+     * Esperamos hasta que usuarioActual tenga valor.
+     */
+    await new Promise<void>((resolve, reject) => {
+
+      const timeoutId = setTimeout(() => {
+
+        subscription.unsubscribe();
+
+        reject(
+          new Error(
+            'El inicio de sesión fue correcto, pero no se pudo cargar el perfil de OLITRACK.'
+          )
+        );
+
+      }, 10000);
+
+      const subscription =
+        this.usuarioActual$.subscribe(usuario => {
+
+          if (usuario) {
+
+            clearTimeout(timeoutId);
+
+            subscription.unsubscribe();
+
+            resolve();
+          }
+        });
+    });
+  }
+
+  // =========================================================
+  // FIREBASE ID TOKEN
+  // =========================================================
+
+  async obtenerIdToken(): Promise<string | null> {
+
+    const firebaseUser: FirebaseUser | null =
+      this.auth.currentUser;
+
+    if (!firebaseUser) {
+      return null;
+    }
+
+    try {
+
+      return await firebaseUser.getIdToken();
+
+    } catch (error) {
+
+      console.error(
+        '[AuthService] Error obteniendo Firebase ID Token:',
+        error
+      );
+
+      return null;
+    }
+  }
+
+  // =========================================================
+  // USUARIO ACTUAL
+  // =========================================================
+
+  get usuarioActual(): Usuario | null {
+
+    return this.usuarioActualSubject.value;
+  }
+
+  // =========================================================
+  // ESTADO DE AUTENTICACIÓN
+  // =========================================================
+
+  estaAutenticado(): boolean {
+
+    return this.usuarioActual !== null;
+  }
+
+  // =========================================================
+  // COMPROBAR ROL
+  // =========================================================
+
+  tieneRol(
+    ...roles: string[]
+  ): boolean {
+
+    const usuario = this.usuarioActual;
+
+    if (!usuario) {
+      return false;
+    }
+
+    return roles.includes(usuario.rol);
+  }
