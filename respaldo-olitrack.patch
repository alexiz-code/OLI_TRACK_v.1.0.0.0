+import {
+  ChangeDetectionStrategy,
+  Component,
+  DestroyRef,
+  ElementRef,
+  afterNextRender,
+  effect,
+  inject,
+  input,
+  output,
+  signal,
+  viewChild
+} from '@angular/core';
+
+import * as L from 'leaflet';
+
+import {
+  Cliente,
+  Repartidor
+} from '../../../core/models/olitrack.models';
+
+interface CentroMapa {
+  nombre: string;
+  direccionCentral?: string;
+  latitudCentral?: number;
+  longitudCentral?: number;
+}
+
+const DEFAULT_CENTER: L.LatLngTuple = [-13.1635, -74.224];
+
+/**
+ * Evita inyección de HTML en los popups de Leaflet.
+ */
+const esc = (value: unknown): string =>
+  String(value ?? '').replace(
+    /[&<>"']/g,
+    ch =>
+      ({
+        '&': '&amp;',
+        '<': '&lt;',
+        '>': '&gt;',
+        '"': '&quot;',
+        "'": '&#39;'
+      })[ch]!
+  );
+
+@Component({
+  selector: 'app-ayacucho-map',
+  standalone: true,
+  changeDetection: ChangeDetectionStrategy.OnPush,
+
+  template: `
+    <div
+      class="relative rounded-2xl overflow-hidden border border-slate-200
+             shadow-sm bg-slate-100 w-full"
+    >
+
+      <!-- ENCABEZADO -->
+      <div
+        class="absolute top-3 left-3 z-[400]
+               flex items-center gap-2
+               bg-white/95 backdrop-blur-md
+               px-3 py-1.5 rounded-xl
+               border border-slate-200 shadow-sm
+               text-xs font-medium text-slate-700"
+      >
+        <span
+          class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"
+        ></span>
+
+        <span class="font-bold">
+          Ayacucho (Huamanga)
+        </span>
+
+        <span class="text-slate-400 text-[10px]">
+          GPS en vivo
+        </span>
+      </div>
+
+      <!-- BOTONES -->
+      <div
+        class="absolute top-3 right-3 z-[400]
+               flex items-center gap-1.5"
+      >
+
+        <button
+          type="button"
+          (click)="fitAllPoints()"
+          class="bg-white/95 hover:bg-white
+                 text-slate-700 hover:text-blue-600
+                 px-3 py-1.5 rounded-xl
+                 border border-slate-200 shadow-sm
+                 text-xs font-semibold transition-colors"
+        >
+          Ajustar Todo
+        </button>
+
+        <button
+          type="button"
+          (click)="recenterCentral()"
+          class="bg-white/95 hover:bg-white
+                 text-slate-700 hover:text-blue-600
+                 px-3 py-1.5 rounded-xl
+                 border border-slate-200 shadow-sm
+                 text-xs font-semibold transition-colors"
+        >
+          Planta Central
+        </button>
+
+      </div>
+
+      <!-- MAPA -->
+      <div
+        #mapContainer
+        [style.height]="height()"
+        class="w-full z-10"
+      ></div>
+
+      <!-- LEYENDA -->
+      <div
+        class="absolute bottom-3 right-3 z-[400]
+               bg-white/95 backdrop-blur-md
+               px-3 py-2 rounded-xl
+               border border-slate-200 shadow-md
+               text-[11px]
+               flex flex-wrap items-center gap-3"
+      >
+
+        @if (showAlmacen()) {
+          <div class="flex items-center gap-1.5">
+
+            <span
+              class="w-2.5 h-2.5 rounded-full bg-blue-600"
+            ></span>
+
+            <span class="text-slate-700 font-medium">
+              Planta Central
+            </span>
+
+          </div>
+        }
+
+        @if (showRepartidores()) {
+          <div class="flex items-center gap-1.5">
+
+            <span
+              class="w-2.5 h-2.5 rounded-full bg-emerald-600"
+            ></span>
+
+            <span class="text-slate-700 font-medium">
+              Repartidor disponible
+            </span>
+
+          </div>
+
+          <div class="flex items-center gap-1.5">
+
+            <span
+              class="w-2.5 h-2.5 rounded-full bg-amber-500"
+            ></span>
+
+            <span class="text-slate-700 font-medium">
+              En ruta
+            </span>
+
+          </div>
+        }
+
+        @if (showClientes()) {
+          <div class="flex items-center gap-1.5">
+
+            <span
+              class="w-2.5 h-2.5 rounded-full bg-indigo-600"
+            ></span>
+
+            <span class="text-slate-700 font-medium">
+              Clientes Registrados
+            </span>
+
+          </div>
+        }
+
+      </div>
+    </div>
+  `
+})
+export class AyacuchoMapComponent {
+
+  private readonly destroyRef = inject(DestroyRef);
+
+  // ===========================================================
+  // INPUTS / OUTPUTS
+  // ===========================================================
+
+  readonly repartidores = input<Repartidor[]>([]);
+
+  readonly clientes = input<Cliente[]>([]);
+
+  readonly companyConfig = input.required<CentroMapa>();
+
+  readonly selectedClienteId = input<string>();
+
+  readonly selectedRepartidorId = input<string>();
+
+  readonly height = input('520px');
+
+  readonly showClientes = input(true);
+
+  readonly showRepartidores = input(true);
+
+  readonly showAlmacen = input(true);
+
+  readonly selectCliente = output<Cliente>();
+
+  readonly selectRepartidor = output<Repartidor>();
+
+  // ===========================================================
+  // ESTADO INTERNO
+  // ===========================================================
+
+  private readonly mapContainer =
+    viewChild.required<ElementRef<HTMLDivElement>>('mapContainer');
+
+  private map?: L.Map;
+
+  private markersLayer?: L.LayerGroup;
+
+  private readonly mapReady = signal(false);
+
+  // ===========================================================
+  // CONSTRUCTOR
+  // ===========================================================
+
+  constructor() {
+
+    /*
+     * Leaflet necesita acceder al DOM y a window.
+     * Por eso el mapa se inicializa después de renderizar
+     * el componente en el navegador.
+     */
+    afterNextRender(() => this.initMap());
+
+    /*
+     * Cada vez que cambien los signals utilizados por
+     * renderMarkers(), se vuelven a dibujar los marcadores.
+     */
+    effect(() => {
+
+      if (this.mapReady()) {
+        this.renderMarkers();
+      }
+
+    });
+
+    /*
+     * Limpieza al destruir el componente.
+     */
+    this.destroyRef.onDestroy(() => {
+
+      this.map?.remove();
+
+      this.map = undefined;
+
+    });
+  }
+
+  // ===========================================================
+  // INICIALIZACIÓN DEL MAPA
+  // ===========================================================
+
+  private initMap(): void {
+
+    const cfg = this.companyConfig();
+
+    const center: L.LatLngTuple = [
+      cfg?.latitudCentral ?? DEFAULT_CENTER[0],
+      cfg?.longitudCentral ?? DEFAULT_CENTER[1]
+    ];
+
+    const el = this.mapContainer().nativeElement;
+
+    this.map = L.map(el, {
+      center,
+      zoom: 14,
+      zoomControl: true
+    });
+
+    L.tileLayer(
+      'https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',
+      {
+        attribution:
+          '&copy; OpenStreetMap contributors • Ayacucho, Perú',
+        maxZoom: 19
+      }
+    ).addTo(this.map);
+
+    this.markersLayer = L.layerGroup().addTo(this.map);
+
+    /*
+     * Corrige el tamaño del mapa cuando el contenedor
+     * cambia de tamaño.
+     */
+    const observer = new ResizeObserver(() => {
+      this.map?.invalidateSize();
+    });
+
+    observer.observe(el);
+
+    this.destroyRef.onDestroy(() => {
+      observer.disconnect();
+    });
+
+    this.mapReady.set(true);
+  }
+
+  // ===========================================================
+  // ICONOS
+  // ===========================================================
+
+  private divIcon(
+    emoji: string,
+    size: number,
+    classes: string
+  ): L.DivIcon {
+
+    return L.divIcon({
+      className: 'custom-leaflet-icon',
+
+      html: `
+        <div
+          class="flex items-center justify-center
+                 w-full h-full
+                 border-2 border-white
+                 rounded-full text-white ${classes}"
+        >
+          ${emoji}
+        </div>
+      `,
+
+      iconSize: [size, size],
+
+      iconAnchor: [size / 2, size]
+    });
+  }
+
+  // ===========================================================
+  // MARCADORES
+  // ===========================================================
+
+  private renderMarkers(): void {
+
+    const layer = this.markersLayer;
+
+    if (!layer || !this.map) {
+      return;
+    }
+
+    layer.clearLayers();
+
+    // =========================================================
+    // PLANTA CENTRAL
+    // =========================================================
+
+    const cfg = this.companyConfig();
+
+    if (
+      this.showAlmacen() &&
+      cfg?.latitudCentral != null &&
+      cfg?.longitudCentral != null
+    ) {
+
+      L.marker(
+        [
+          cfg.latitudCentral,
+          cfg.longitudCentral
+        ],
+        {
+          icon: this.divIcon(
+            '🏭',
+            40,
+            'bg-blue-600 shadow-xl'
+          )
+        }
+      )
+        .addTo(layer)
+        .bindPopup(`
+          <div class="p-1 text-xs">
+
+            <p class="font-bold text-blue-700">
+              ${esc(cfg.nombre)}
+            </p>
+
+            <p class="text-slate-600">
+              ${esc(cfg.direccionCentral)}
+            </p>
+
+          </div>
+        `);
+    }
+
+    // =========================================================
+    // REPARTIDORES
+    // =========================================================
+
+    if (this.showRepartidores()) {
+
+      const selectedId = this.selectedRepartidorId();
+
+      for (const rep of this.repartidores()) {
+
+        const pos = rep.ubicacionActual;
+
+        if (!pos) {
+          continue;
+        }
+
+        const isSelected =
+          rep.id === selectedId;
+
+        const isEnRuta =
+          rep.estado === 'EN_RUTA';
+
+        const classes = [
+          isEnRuta
+            ? 'bg-amber-500'
+            : 'bg-emerald-600',
+
+          'shadow-lg',
+
+          isSelected
+            ? 'ring-4 ring-blue-500 scale-125'
+            : ''
+        ].join(' ');
+
+        L.marker(
+          [
+            pos.latitud,
+            pos.longitud
+          ],
+          {
+            icon: this.divIcon(
+              '🛵',
+              36,
+              classes
+            )
+          }
+        )
+          .addTo(layer)
+
+          .bindPopup(`
+            <div class="p-1.5 text-xs min-w-[160px]">
+
+              <div
+                class="flex items-center justify-between
+                       border-b pb-1 mb-1"
+              >
+
+                <span class="font-bold">
+                  Placa: ${esc(rep.placaVehiculo)}
+                </span>
+
+                <span
+                  class="px-1.5 py-0.5
+                         rounded text-[10px]
+                         font-bold
+                         ${
+                           isEnRuta
+                             ? 'bg-amber-100 text-amber-800'
+                             : 'bg-emerald-100 text-emerald-800'
+                         }"
+                >
+                  ${esc(rep.estado)}
+                </span>
+
+              </div>
+
+            </div>
+          `)
+
+          .on(
+            'click',
+            () => this.selectRepartidor.emit(rep)
+          );
+      }
+    }
+
+    // =========================================================
+    // CLIENTES
+    // =========================================================
+
+    if (this.showClientes()) {
+
+      const selectedId =
+        this.selectedClienteId();
+
+      for (const cli of this.clientes()) {
+
+        if (!cli.ubicacion) {
+          continue;
+        }
+
+        const isSelected =
+          cli.id === selectedId;
+
+        const classes = [
+          'bg-indigo-600 shadow-md',
+
+          isSelected
+            ? 'ring-4 ring-cyan-400 scale-125'
+            : ''
+        ].join(' ');
+
+        L.marker(
+          [
+            cli.ubicacion.latitud,
+            cli.ubicacion.longitud
+          ],
+          {
+            icon: this.divIcon(
+              '🏪',
+              32,
+              classes
+            )
+          }
+        )
+          .addTo(layer)
+
+          .bindPopup(`
+            <div class="p-1.5 text-xs min-w-[180px]">
+
+              <span class="font-bold">
+                ${esc(cli.nombreNegocio)}
+              </span>
+
+              <p class="text-slate-600 text-[11px] mt-0.5">
+                ${esc(cli.direccion)}
+              </p>
+
+            </div>
+          `)
+
+          .on(
+            'click',
+            () => this.selectCliente.emit(cli)
+          );
+      }
+    }
+  }
+
+  // ===========================================================
+  // ACCIONES
+  // ===========================================================
+
+  recenterCentral(): void {
+
+    const cfg = this.companyConfig();
+
+    if (
+      this.map &&
+      cfg?.latitudCentral != null &&
+      cfg?.longitudCentral != null
+    ) {
+
+      this.map.setView(
+        [
+          cfg.latitudCentral,
+          cfg.longitudCentral
+        ],
+        14
+      );
+    }
+  }
+
+  fitAllPoints(): void {
+
+    if (!this.map) {
+      return;
+    }
+
+    const pts: L.LatLngTuple[] = [];
+
+    const cfg = this.companyConfig();
+
+    // Planta central
+    if (
+      cfg?.latitudCentral != null &&
+      cfg?.longitudCentral != null
+    ) {
+
+      pts.push([
+        cfg.latitudCentral,
+        cfg.longitudCentral
+      ]);
+    }
+
+    // Repartidores
+    for (const r of this.repartidores()) {
+
+      if (r.ubicacionActual) {
+
+        pts.push([
+          r.ubicacionActual.latitud,
+          r.ubicacionActual.longitud
+        ]);
+
+      }
+    }
+
+    // Clientes
+    for (const c of this.clientes()) {
+
+      if (c.ubicacion) {
+
+        pts.push([
+          c.ubicacion.latitud,
+          c.ubicacion.longitud
+        ]);
+
+      }
+    }
+
+    // Ajustar mapa
+    if (pts.length > 0) {
+
+      this.map.fitBounds(
+        L.latLngBounds(pts),
+        {
+          padding: [50, 50]
+        }
+      );
+    }
+  }
+}
