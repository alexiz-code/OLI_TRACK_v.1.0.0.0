+import {
+  Component,
+  inject
+} from '@angular/core';
+
+import {
+  CommonModule
+} from '@angular/common';
+
+import {
+  FormBuilder,
+  ReactiveFormsModule,
+  Validators
+} from '@angular/forms';
+
+import {
+  Router,
+  RouterLink
+} from '@angular/router';
+
+import {
+  AuthService
+} from '../../core/services/auth.service';
+
+import {
+  Usuario
+} from '../../core/models/olitrack.models';
+
+@Component({
+  selector: 'app-login',
+
+  standalone: true,
+
+  imports: [
+    CommonModule,
+    ReactiveFormsModule,
+    RouterLink
+  ],
+
+  template: `
+    <div class="login-container">
+
+      <div class="login-card">
+
+        <h1>OLITRACK</h1>
+
+        <h2>Iniciar sesión</h2>
+
+        <form
+          [formGroup]="form"
+          (ngSubmit)="ingresar()"
+        >
+
+          <!-- ============================= -->
+          <!-- CORREO ELECTRÓNICO -->
+          <!-- ============================= -->
+
+          <div class="campo">
+
+            <label for="email">
+              Correo electrónico
+            </label>
+
+            <input
+              id="email"
+              type="email"
+              formControlName="email"
+              placeholder="correo@ejemplo.com"
+              autocomplete="email"
+            />
+
+            <small
+              *ngIf="
+                form.controls.email.touched &&
+                form.controls.email.hasError('required')
+              "
+            >
+              El correo electrónico es obligatorio.
+            </small>
+
+            <small
+              *ngIf="
+                form.controls.email.touched &&
+                form.controls.email.hasError('email')
+              "
+            >
+              Ingresa un correo electrónico válido.
+            </small>
+
+          </div>
+
+
+          <!-- ============================= -->
+          <!-- CONTRASEÑA -->
+          <!-- ============================= -->
+
+          <div class="campo">
+
+            <label for="password">
+              Contraseña
+            </label>
+
+            <input
+              id="password"
+              type="password"
+              formControlName="password"
+              placeholder="********"
+              autocomplete="current-password"
+            />
+
+            <small
+              *ngIf="
+                form.controls.password.touched &&
+                form.controls.password.hasError('required')
+              "
+            >
+              La contraseña es obligatoria.
+            </small>
+
+          </div>
+
+
+          <!-- ============================= -->
+          <!-- MENSAJE DE ERROR -->
+          <!-- ============================= -->
+
+          <p
+            class="error"
+            *ngIf="error"
+            role="alert"
+          >
+            {{ error }}
+          </p>
+
+
+          <!-- ============================= -->
+          <!-- BOTÓN -->
+          <!-- ============================= -->
+
+          <button
+            type="submit"
+            [disabled]="form.invalid || cargando"
+          >
+            {{ cargando
+              ? 'Ingresando...'
+              : 'Iniciar sesión'
+            }}
+          </button>
+
+        </form>
+
+
+        <!-- ============================= -->
+        <!-- REGISTRO -->
+        <!-- ============================= -->
+
+        <p class="registro">
+
+          ¿No tienes una cuenta?
+
+          <a routerLink="/auth/registro">
+            Regístrate
+          </a>
+
+        </p>
+
+      </div>
+
+    </div>
+  `,
+
+  styles: [`
+
+    /* =====================================
+       CONTENEDOR PRINCIPAL
+       ===================================== */
+
+    .login-container {
+      min-height: 100vh;
+
+      display: flex;
+
+      justify-content: center;
+
+      align-items: center;
+
+      padding: 20px;
+
+      background: #f4f6f8;
+    }
+
+
+    /* =====================================
+       TARJETA
+       ===================================== */
+
+    .login-card {
+      width: 100%;
+
+      max-width: 420px;
+
+      background: white;
+
+      padding: 35px;
+
+      border-radius: 15px;
+
+      box-shadow:
+        0 8px 25px
+        rgba(0, 0, 0, 0.12);
+
+      box-sizing: border-box;
+    }
+
+
+    /* =====================================
+       TÍTULO
+       ===================================== */
+
+    h1 {
+      text-align: center;
+
+      margin: 0;
+
+      color: #1976d2;
+
+      font-size: 32px;
+
+      font-weight: 700;
+    }
+
+
+    /* =====================================
+       SUBTÍTULO
+       ===================================== */
+
+    h2 {
+      text-align: center;
+
+      margin: 10px 0 30px;
+
+      color: #333;
+
+      font-size: 24px;
+    }
+
+
+    /* =====================================
+       CAMPOS
+       ===================================== */
+
+    .campo {
+      margin-bottom: 20px;
+    }
+
+
+    /* =====================================
+       LABEL
+       ===================================== */
+
+    label {
+      display: block;
+
+      margin-bottom: 7px;
+
+      font-weight: 600;
+
+      color: #333;
+    }
+
+
+    /* =====================================
+       INPUT
+       ===================================== */
+
+    input {
+      width: 100%;
+
+      box-sizing: border-box;
+
+      padding: 12px;
+
+      border: 1px solid #ccc;
+
+      border-radius: 8px;
+
+      font-size: 15px;
+
+      transition:
+        border-color 0.2s ease,
+        box-shadow 0.2s ease;
+    }
+
+
+    input:focus {
+      outline: none;
+
+      border-color: #1976d2;
+
+      box-shadow:
+        0 0 0 3px
+        rgba(25, 118, 210, 0.1);
+    }
+
+
+    /* =====================================
+       INPUT CON ERROR
+       ===================================== */
+
+    input.ng-invalid.ng-touched {
+      border-color: #d32f2f;
+    }
+
+
+    /* =====================================
+       MENSAJES DE VALIDACIÓN
+       ===================================== */
+
+    small {
+      display: block;
+
+      margin-top: 5px;
+
+      color: #d32f2f;
+
+      font-size: 13px;
+    }
+
+
+    /* =====================================
+       ERROR GENERAL
+       ===================================== */
+
+    .error {
+      color: #d32f2f;
+
+      background: #ffebee;
+
+      border: 1px solid #ffcdd2;
+
+      padding: 10px;
+
+      border-radius: 6px;
+
+      margin-bottom: 15px;
+
+      font-size: 14px;
+    }
+
+
+    /* =====================================
+       BOTÓN
+       ===================================== */
+
+    button {
+      width: 100%;
+
+      padding: 13px;
+
+      border: none;
+
+      border-radius: 8px;
+
+      background: #1976d2;
+
+      color: white;
+
+      font-size: 16px;
+
+      font-weight: 600;
+
+      cursor: pointer;
+
+      transition:
+        background 0.2s ease,
+        opacity 0.2s ease;
+    }
+
+
+    button:hover:not(:disabled) {
+      background: #1565c0;
+    }
+
+
+    button:disabled {
+      opacity: 0.6;
+
+      cursor: not-allowed;
+    }
+
+
+    /* =====================================
+       REGISTRO
+       ===================================== */
+
+    .registro {
+      text-align: center;
+
+      margin-top: 20px;
+
+      color: #555;
+    }
+
+
+    .registro a {
+      color: #1976d2;
+
+      text-decoration: none;
+
+      font-weight: 600;
+    }
+
+
+    .registro a:hover {
+      text-decoration: underline;
+    }
+
+  `]
+})
+export class LoginComponent {
+
+  /* =====================================
+     INYECCIÓN DE DEPENDENCIAS
+     ===================================== */
+
+  private readonly fb = inject(FormBuilder);
+
+  private readonly authService =
+    inject(AuthService);
+
+  private readonly router =
+    inject(Router);
+
+
+  /* =====================================
+     FORMULARIO
+     ===================================== */
+
+  readonly form = this.fb.nonNullable.group({
+
+    email: [
+      '',
+      [
+        Validators.required,
+        Validators.email
+      ]
+    ],
+
+    password: [
+      '',
+      [
+        Validators.required
+      ]
+    ]
+
+  });
+
+
+  /* =====================================
+     ESTADO
+     ===================================== */
+
+  cargando = false;
+
+  error = '';
+
+
+  /* =====================================
+     INGRESAR
+     ===================================== */
+
+  async ingresar(): Promise<void> {
+
+    /*
+     * Verificar formulario.
+     */
+
+    if (this.form.invalid) {
+
+      this.form.markAllAsTouched();
+
+      return;
+    }
+
+
+    /*
+     * Activar estado de carga.
+     */
+
+    this.cargando = true;
+
+    this.error = '';
+
+
+    /*
+     * Obtener datos.
+     */
+
+    const {
+      email,
+      password
+    } = this.form.getRawValue();
+
+
+    try {
+
+      /*
+       * Iniciar sesión en Firebase.
+       */
+
+      await this.authService.login(
+        email.trim(),
+        password
+      );
+
+
+      /*
+       * Firebase puede haber autenticado
+       * al usuario antes de que
+       * AuthService termine de cargar
+       * /usuarios/me.
+       *
+       * Esperamos el perfil.
+       */
+
+      const usuario =
+        await this.esperarUsuario();
+
+
+      /*
+       * Verificar perfil.
+       */
+
+      if (!usuario) {
+
+        this.error =
+          'No se pudo cargar el perfil del usuario.';
+
+        return;
+      }
+
+
+      /*
+       * Redireccionar según rol.
+       */
+
+      switch (usuario.rol) {
+
+        case 'ADMINISTRADOR':
+
+          await this.router.navigate([
+            '/admin'
+          ]);
+
+          break;
+
+
+        case 'SUPERVISOR':
+
+          await this.router.navigate([
+            '/supervisor'
+          ]);
+
+          break;
+
+
+        case 'REPARTIDOR':
+
+          await this.router.navigate([
+            '/repartidor'
+          ]);
+
+          break;
+
+
+        case 'CLIENTE':
+
+          await this.router.navigate([
+            '/cliente'
+          ]);
+
+          break;
+
+
+        default:
+
+          this.error =
+            'El usuario no tiene un rol válido.';
+
+          break;
+      }
+
+
+    } catch (error: unknown) {
+
+      /*
+       * Obtener código del error.
+       */
+
+      const code =
+        this.obtenerCodigoError(error);
+
+
+      /*
+       * Mostrar mensaje amigable.
+       */
+
+      this.error =
+        this.mapearError(code);
+
+
+    } finally {
+
+      this.cargando = false;
+
+    }
+  }
+
+
+  /* =====================================
+     ESPERAR USUARIO
+     ===================================== */
+
+  private async esperarUsuario():
+    Promise<Usuario | null> {
+
+    /*
+     * Primero comprobar si ya existe
+     * el usuario.
+     */
+
+    const usuarioActual =
+      this.authService.usuarioActual;
+
+
+    if (usuarioActual) {
+
+      return usuarioActual;
+
+    }
+
+
+    /*
+     * Esperar usuarioActual$.
+     */
+
+    return new Promise<Usuario | null>(
+      (resolve) => {
+
+        let resuelto = false;
+
+
+        const subscription =
+          this.authService.usuarioActual$
+            .subscribe(usuario => {
+
+              /*
+               * El perfil ya fue cargado.
+               */
+
+              if (
+                usuario &&
+                !resuelto
+              ) {
+
+                resuelto = true;
+
+                subscription.unsubscribe();
+
+                resolve(usuario);
+
+              }
+
+            });
+
+
+        /*
+         * Tiempo máximo de espera:
+         * 10 segundos.
+         */
+
+        setTimeout(() => {
+
+          if (!resuelto) {
+
+            resuelto = true;
+
+            subscription.unsubscribe();
+
+            resolve(
+              this.authService.usuarioActual
+            );
+
+          }
+
+        }, 10000);
+
+      }
+    );
+  }
+
+
+  /* =====================================
+     OBTENER CÓDIGO DE ERROR
+     ===================================== */
+
+  private obtenerCodigoError(
+    error: unknown
+  ): string {
+
+    if (
+      typeof error === 'object' &&
+      error !== null &&
+      'code' in error
+    ) {
+
+      const errorConCodigo =
+        error as {
+          code?: unknown
+        };
+
+
+      return String(
+        errorConCodigo.code ?? ''
+      );
+    }
+
+
+    return '';
+  }
+
+
+  /* =====================================
+     MAPEAR ERROR FIREBASE
+     ===================================== */
+
+  private mapearError(
+    code: string
+  ): string {
+
+    switch (code) {
+
+      case 'auth/invalid-credential':
+
+      case 'auth/wrong-password':
+
+      case 'auth/user-not-found':
+
+        return (
+          'Correo o contraseña incorrectos.'
+        );
+
+
+      case 'auth/invalid-email':
+
+        return (
+          'El correo electrónico no es válido.'
+        );
+
+
+      case 'auth/user-disabled':
+
+        return (
+          'Esta cuenta se encuentra deshabilitada.'
+        );
+
+
+      case 'auth/too-many-requests':
+
+        return (
+          'Demasiados intentos. ' +
+          'Intenta nuevamente más tarde.'
+        );
+
+
+      case 'auth/network-request-failed':
+
+        return (
+          'No se pudo conectar con Firebase. ' +
+          'Verifica tu conexión a Internet.'
+        );
+
+
+      default:
+
+        return (
+          'No se pudo iniciar sesión. ' +
+          'Verifica tus datos.'
+        );
+    }
+  }
+}
