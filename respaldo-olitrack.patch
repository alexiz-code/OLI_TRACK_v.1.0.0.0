+  async guardarProducto(): Promise<void> {
+
+    const f =
+      this.productoForm;
+
+    if (!f.nombre.trim()) {
+
+      this.service.triggerToast(
+        'WARNING',
+        'Nombre requerido',
+        'Ingrese el nombre del producto.'
+      );
+
+      return;
+    }
+
+    if (!f.categoria.trim()) {
+
+      this.service.triggerToast(
